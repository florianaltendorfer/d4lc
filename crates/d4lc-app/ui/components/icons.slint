// Trash (remove preset). One component: lid, handle and body all derive
// from the requested size — no caller-side offset correction.
export component TrashIcon {
    in property <color> icon-color: #FFFFFF;

    preferred-width: 24px;
    preferred-height: 24px;

    // Lid — the full glyph width (grid x 4..20, y 6..8).
    Rectangle {
        x: IconMetrics.unit(parent.width, 4.0);
        y: IconMetrics.unit(parent.height, 6.0);
        width: IconMetrics.unit(parent.width, 16.0);
        height: IconMetrics.unit(parent.height, 2.0);
        background: icon-color;
    }

    // Handle (grid x 9..15, y 3..5).
    Rectangle {
        x: IconMetrics.unit(parent.width, 9.0);
        y: IconMetrics.unit(parent.height, 3.0);
        width: IconMetrics.unit(parent.width, 6.0);
        height: IconMetrics.unit(parent.height, 2.0);
        background: icon-color;
    }

    // Body (grid y 9..21, tapering from x 6..18 to x 7..17).
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 6 9 L 18 9 L 17 21 L 7 21 Z";
        fill: icon-color;
    }
}

