// Upstream Kind=Bug — the Debug nav entry (MainWindow.xaml:131).
export component BugIcon {
    in property <color> icon-color: #FFFFFF;

    preferred-width: 24px;
    preferred-height: 24px;

    // Body
    Rectangle {
        x: IconMetrics.unit(parent.width, 8.0);
        y: IconMetrics.unit(parent.height, 8.0);
        width: IconMetrics.unit(parent.width, 8.0);
        height: IconMetrics.unit(parent.height, 11.0);
        border-radius: IconMetrics.unit(parent.width, 4.0);
        background: icon-color;
    }

    // Head
    Rectangle {
        x: IconMetrics.unit(parent.width, 9.5);
        y: IconMetrics.unit(parent.height, 4.0);
        width: IconMetrics.unit(parent.width, 5.0);
        height: IconMetrics.unit(parent.height, 5.0);
        border-radius: IconMetrics.unit(parent.width, 2.5);
        background: icon-color;
    }

    // Legs (three per side) + body seam
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 4 9 L 8 11 M 3.5 13 L 8 13 M 4 17 L 8 15 M 20 9 L 16 11 M 20.5 13 L 16 13 M 20 17 L 16 15 M 12 8 L 12 19";
        stroke: icon-color;
        stroke-width: IconMetrics.stroke(parent.width, 2.0);
        fill: transparent;
    }
}

// Upstream Kind=Cog — the Settings nav entry (MainWindow.xaml:143).
// Solid 8-tooth polygon (precomputed; avoids element rotation, which
// Slint Rectangles do not expose).
export component CogIcon {
    in property <color> icon-color: #FFFFFF;
    // Center hole must read as the surface the gear sits on
    // (red active block or dark rail / panel).
    in property <color> hole-color: #1B1B1B;

    preferred-width: 24px;
    preferred-height: 24px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 23.40 12.00 L 23.09 14.66 L 20.18 14.66 L 18.08 18.08 L 20.06 20.06 L 17.96 21.72 L 15.90 19.66 L 12.00 20.60 L 12.00 23.40 L 9.34 23.09 L 9.34 20.18 L 5.92 18.08 L 3.94 20.06 L 2.28 17.96 L 4.34 15.90 L 3.40 12.00 L 0.60 12.00 L 0.91 9.34 L 3.82 9.34 L 5.92 5.92 L 3.94 3.94 L 6.04 2.28 L 8.10 4.34 L 12.00 3.40 L 12.00 0.60 L 14.66 0.91 L 14.66 3.82 L 18.08 5.92 L 20.06 3.94 L 21.72 6.04 L 19.66 8.10 L 20.60 12.00 Z";
        fill: icon-color;
    }

    Rectangle {
        x: (parent.width - IconMetrics.unit(parent.width, 6.0)) / 2;
        y: (parent.height - IconMetrics.unit(parent.height, 6.0)) / 2;
        width: IconMetrics.unit(parent.width, 6.0);
        height: IconMetrics.unit(parent.height, 6.0);
        border-radius: IconMetrics.unit(parent.width, 3.0);
        background: hole-color;
    }
}

// ── Panel / action icons ────────────────────────────────────────────────

// Overlay power symbol (affixes control row). Requested at 18px there;
// the ring, the bar and the stroke all follow that request.
export component PowerIcon {
    in property <color> icon-color: #FFFFFF;

    preferred-width: 24px;
    preferred-height: 24px;

    Rectangle {
        width: IconMetrics.unit(parent.width, 16.0);
        height: IconMetrics.unit(parent.height, 16.0);
        x: (parent.width - self.width) / 2;
        y: IconMetrics.unit(parent.height, 6.0);
        border-width: IconMetrics.stroke(parent.width, 2.0);
        border-color: icon-color;
        border-radius: IconMetrics.unit(parent.width, 8.0);
    }

    Rectangle {
        x: (parent.width - IconMetrics.unit(parent.width, 2.0)) / 2;
        y: IconMetrics.unit(parent.height, 2.0);
        width: IconMetrics.unit(parent.width, 2.0);
        height: IconMetrics.unit(parent.height, 10.0);
        background: icon-color;
    }
}

// Camera (debug screenshot).
export component CameraIcon {
    in property <color> icon-color: #FFFFFF;
    in property <color> hole-color: #1F1F1F;

    preferred-width: 24px;
    preferred-height: 24px;

    // Top notch
    Rectangle {
        x: IconMetrics.unit(parent.width, 8.0);
        y: IconMetrics.unit(parent.height, 4.0);
        width: IconMetrics.unit(parent.width, 8.0);
        height: IconMetrics.unit(parent.height, 4.0);
        background: icon-color;
    }

    Rectangle {
        x: IconMetrics.unit(parent.width, 3.0);
        y: IconMetrics.unit(parent.height, 7.0);
        width: IconMetrics.unit(parent.width, 18.0);
        height: IconMetrics.unit(parent.height, 13.0);
        border-radius: IconMetrics.unit(parent.width, 2.0);
        background: icon-color;
    }

    Rectangle {
        x: (parent.width - IconMetrics.unit(parent.width, 8.0)) / 2;
        y: IconMetrics.unit(parent.height, 10.0);
        width: IconMetrics.unit(parent.width, 8.0);
        height: IconMetrics.unit(parent.height, 8.0);
        border-radius: IconMetrics.unit(parent.width, 4.0);
        background: hole-color;
    }
}

