// Minimal geometric icon set for the d4lc desktop shell.
// Upstream WPF uses MahApps PackIconMaterial glyphs; we approximate the exact
// kinds used by upstream MainWindow.xaml (Github, CoffeeOutline,
// HelpCircleOutline, Tooltip, ScaleBalance, TooltipTextOutline, Bug, Cog)
// with Slint Path / Rectangle primitives so no image dependency is added.
//
// ── One size contract for every icon ────────────────────────────────────
// Every glyph below is authored on the same 24x24 design grid and derives
// its geometry from the size the caller requests (`IconMetrics`, directly
// below). An icon requested at 15, 18 or 24px therefore draws the same
// glyph, inset and stroked proportionally — there is no second, hidden
// "designed for" size that a request can miss:
//
//   drawing area    the icon element's own width/height (preferred 24px)
//   visible contour IconMetrics.contour(size) — the 20/24 glyph box
//   inner padding   IconMetrics.pad(size) — the 2/24 margin on each side
//   stroke weight   IconMetrics.stroke(size, n) — n/24, never below 1px
//   grid distance   IconMetrics.unit(size, n) — n units of the 24 grid
//
// Callers request a size (`width`/`height`); they never correct the glyph
// with per-call offsets.

// The single size contract every icon in this file consumes. `size` is the
// requested icon size (the drawing area), `units` a distance on the 24x24
// design grid the glyph is authored on. At 24px every function reproduces
// the grid value exactly, so the 24px rendering is unchanged by the
// proportional form.
export global IconMetrics {
    public pure function unit(size: length, units: float) -> length {
        size * (units / 24.0)
    }

    // The inner margin between the drawing area and the visible contour:
    // two grid units on each side, so the optical margin stays constant at
    // any requested size.
    public pure function pad(size: length) -> length {
        size * (2.0 / 24.0)
    }

    // The visible contour of a glyph: the drawing area minus both inner
    // margins.
    public pure function contour(size: length) -> length {
        size - 2 * IconMetrics.pad(size)
    }

    // Stroke weight in grid units (2 units for every contour in this file,
    // 2.5 for the two thin diagonal/rounded strokes). Below ~12px a
    // proportional stroke would vanish, so it is clamped to one device
    // pixel: a small icon keeps a visible contour instead of a fading one.
    public pure function stroke(size: length, units: float) -> length {
        max(IconMetrics.unit(size, units), 1px)
    }
}

// ── Header window-command icons (white on the red app header) ──────────

// Upstream Kind=Github (MainWindow.xaml:36-39).
export component GithubIcon {
    in property <color> icon-color: #FFFFFF;

    preferred-width: 24px;
    preferred-height: 24px;

    // Face plate (grid x 4..20 centered, y 4..20, radius 8).
    Rectangle {
        y: IconMetrics.unit(parent.height, 4.0);
        width: IconMetrics.unit(parent.width, 16.0);
        height: IconMetrics.unit(parent.height, 16.0);
        x: (parent.width - self.width) / 2;
        border-width: IconMetrics.stroke(parent.width, 2.0);
        border-color: icon-color;
        border-radius: IconMetrics.unit(parent.width, 8.0);
    }

    // Ears
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 4 8 L 7 3 L 9.5 7 Z M 20 8 L 17 3 L 14.5 7 Z";
        fill: icon-color;
    }
}

// Upstream Kind=CoffeeOutline (MainWindow.xaml:41-44).
export component CoffeeOutlineIcon {
    in property <color> icon-color: #FFFFFF;

    preferred-width: 24px;
    preferred-height: 24px;

    // Cup body (outline)
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 4 6 L 16 6 L 16 14 C 16 16.2 14.2 18 12 18 L 8 18 C 5.8 18 4 16.2 4 14 Z";
        stroke: icon-color;
        stroke-width: IconMetrics.stroke(parent.width, 2.0);
        fill: transparent;
    }

    // Handle
    Rectangle {
        x: IconMetrics.unit(parent.width, 17.0);
        y: IconMetrics.unit(parent.height, 8.0);
        width: IconMetrics.unit(parent.width, 4.0);
        height: IconMetrics.unit(parent.height, 6.0);
        border-width: IconMetrics.stroke(parent.width, 2.0);
        border-color: icon-color;
        border-radius: IconMetrics.unit(parent.width, 2.0);
    }
}

// Upstream Kind=HelpCircleOutline (MainWindow.xaml:46-49).
export component HelpCircleOutlineIcon {
    in property <color> icon-color: #FFFFFF;

    preferred-width: 24px;
    preferred-height: 24px;

    Rectangle {
        width: IconMetrics.contour(parent.width);
        height: IconMetrics.contour(parent.height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-width: IconMetrics.stroke(parent.width, 2.0);
        border-color: icon-color;
        border-radius: IconMetrics.contour(parent.width) / 2;
    }

    Text {
        text: "?";
        color: icon-color;
        font-size: IconMetrics.unit(parent.width, 13.0);
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// ── Nav rail icons (upstream hamburger menu kinds) ──────────────────────

// Upstream Kind=Tooltip — the Affixes nav entry (MainWindow.xaml:116).
