// Upstream Kind=InformationOutline (SettingsView info buttons).
export component InfoOutlineIcon {
    in property <color> icon-color: #FFFFFF;

    preferred-width: 24px;
    preferred-height: 24px;

    Rectangle {
        width: IconMetrics.contour(parent.width) * 0.9;
        height: IconMetrics.contour(parent.height) * 0.9;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-width: IconMetrics.stroke(parent.width, 2.0);
        border-color: icon-color;
        border-radius: self.width / 2;
    }

    Rectangle {
        x: (parent.width - IconMetrics.unit(parent.width, 2.0)) / 2;
        y: IconMetrics.unit(parent.height, 10.0);
        width: IconMetrics.unit(parent.width, 2.0);
        height: IconMetrics.unit(parent.height, 7.0);
        background: icon-color;
    }

    Rectangle {
        x: (parent.width - IconMetrics.unit(parent.width, 2.0)) / 2;
        y: IconMetrics.unit(parent.height, 7.0);
        width: IconMetrics.unit(parent.width, 2.0);
        height: IconMetrics.unit(parent.height, 2.0);
        background: icon-color;
    }
}

