}

// Upstream Kind=ScaleBalance — the Trading nav entry (MainWindow.xaml:121).
export component ScaleBalanceIcon {
    in property <color> icon-color: #FFFFFF;

    preferred-width: 24px;
    preferred-height: 24px;

    // Column
    Rectangle {
        x: (parent.width - IconMetrics.unit(parent.width, 2.0)) / 2;
        y: IconMetrics.unit(parent.height, 4.0);
        width: IconMetrics.unit(parent.width, 2.0);
        height: IconMetrics.unit(parent.height, 14.0);
        background: icon-color;
    }

    // Crossbar
    Rectangle {
        x: IconMetrics.unit(parent.width, 3.0);
        y: IconMetrics.unit(parent.height, 6.0);
        width: IconMetrics.unit(parent.width, 18.0);
        height: IconMetrics.unit(parent.height, 2.0);
        background: icon-color;
    }

    // Base
    Rectangle {
        x: IconMetrics.unit(parent.width, 6.0);
        y: IconMetrics.unit(parent.height, 18.0);
        width: IconMetrics.unit(parent.width, 12.0);
        height: IconMetrics.unit(parent.height, 2.0);
        background: icon-color;
    }

    // Pans
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 3.5 8 L 9.5 8 L 6.5 14 Z M 14.5 8 L 20.5 8 L 17.5 14 Z";
        fill: icon-color;
    }
}

