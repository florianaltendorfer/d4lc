// Catalog cells — the five upstream wanted-card templates collapsed into one
// parameterized card plus the per-category config (cog) cell.
//
// Upstream templates (`AffixView.xaml:1502-2007`), all `#333333` borders with
// `CornerRadius 5` and a 5px margin:
//
// | template              | size    | row 0 left            | row 0 right            | row 1+             |
// | --------------------- | ------- | --------------------- | ---------------------- | ------------------ |
// | `AffixInfoConfig`     | 250x75  | 50px cog              | —                      | —                  |
// | `AffixInfoWanted`     | 250x75  | tempering marker      | class icons + plus     | description        |
// | `AspectInfoWanted`    | 300x130 | codex/seasonal/drop   | class icons + plus     | bold name, desc    |
// | `SigilInfoWanted`     | 250x130 | tier button, seasonal | plus                   | bold name, desc    |
// | `UniqueInfoWanted`    | 300x130 | —                     | class icons + plus     | bold name, desc    |
// | `RuneInfoWanted`      | 250x90  | condition/effect, name| plus                   | description        |
//
// The differences are the parameters below, so the card body exists once.
// Double-clicking the card body adds/edits the entry like the "+" button
// (upstream `MouseBinding LeftDoubleClick` on every template).

import { Metro } from "../theme.slint";
import { CogIcon, PlusIcon } from "icons.slint";

// One 20px marker of the card's row 0 left stack (upstream `Label` +
// `Image Height="20"` pairs). `label` is the upstream tooltip and doubles as
// the accessible name.
export struct CardMarker {
    icon: image,
    label: string,
}

// The `AllowedForPlayerClass` markers of one card: the upstream per-class icon
// row (20px images with their tooltips, `AffixView.xaml:1544-1576`).
export component ClassBadgeRow {
    in property <bool> class-sorc;
    in property <bool> class-druid;
    in property <bool> class-barb;
    in property <bool> class-rogue;
    in property <bool> class-necro;
    in property <bool> class-spirit;
    in property <bool> class-pala;
    in property <bool> class-warlk;

    HorizontalLayout {
        spacing: 2px;

        if class-sorc: Image {
            width: 20px;
            height: 20px;
            source: @image-url("../../../../assets/original/images/class_icon_sorc.png");
            accessible-label: @tr("Sorceress");
            Tooltip { text: @markdown("\{@tr("Sorceress")}"); }
        }
        if class-druid: Image {
            width: 20px;
            height: 20px;
            source: @image-url("../../../../assets/original/images/class_icon_druid.png");
            accessible-label: @tr("Druid");
            Tooltip { text: @markdown("\{@tr("Druid")}"); }
        }
        if class-barb: Image {
            width: 20px;
            height: 20px;
            source: @image-url("../../../../assets/original/images/class_icon_barb.png");
            accessible-label: @tr("Barbarian");
            Tooltip { text: @markdown("\{@tr("Barbarian")}"); }
        }
        if class-rogue: Image {
            width: 20px;
            height: 20px;
            source: @image-url("../../../../assets/original/images/class_icon_rogue.png");
            accessible-label: @tr("Rogue");
            Tooltip { text: @markdown("\{@tr("Rogue")}"); }
        }
        if class-necro: Image {
            width: 20px;
            height: 20px;
            source: @image-url("../../../../assets/original/images/class_icon_necro.png");
            accessible-label: @tr("Necromancer");
            Tooltip { text: @markdown("\{@tr("Necromancer")}"); }
        }
        if class-spirit: Image {
            width: 20px;
            height: 20px;
            source: @image-url("../../../../assets/original/images/class_icon_spiritborn.png");
            accessible-label: @tr("Spiritborn");
            Tooltip { text: @markdown("\{@tr("Spiritborn")}"); }
        }
        if class-pala: Image {
            width: 20px;
            height: 20px;
            source: @image-url("../../../../assets/original/images/class_icon_paladin.png");
            accessible-label: @tr("Paladin");
            Tooltip { text: @markdown("\{@tr("Paladin")}"); }
        }
        if class-warlk: Image {
            width: 20px;
            height: 20px;
            source: @image-url("../../../../assets/original/images/class_icon_warlock.png");
            accessible-label: @tr("Warlock");
            Tooltip { text: @markdown("\{@tr("Warlock")}"); }
        }

        Rectangle {
            background: transparent;
        }
    }
}

// The "+" control of the catalog cards (upstream `PackIconMaterial
// Kind="PlusThick"` at 15px inside a borderless button,
// `AffixView.xaml:1577-1580`). `label` is the accessible button name and
// doubles as the upstream tooltip (`rsTooltipSetAffix` and friends).
component CardAddButton {
    in property <string> label;
    callback clicked();

    Rectangle {
        background: transparent;
        preferred-width: 20px;
        min-width: 20px;
        max-width: 20px;
        preferred-height: 20px;
        min-height: 20px;
        max-height: 20px;
        // Accessibility + headless real-input test harness.
        accessible-role: button;
        accessible-label: root.label;

        PlusIcon {
            width: 14px;
            height: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon-color: Metro.text;
        }

        TouchArea {
            clicked => { clicked(); }
        }
    }
}

// One wanted catalog card of any tab. The cell keeps its upstream size; the
// kind-specific parts are the marker list, the class badge row, the bold name
// row (aspect/sigil/unique) and the sigil tier button.
export component CatalogCard {
    in property <length> card-width: 250px;
    in property <length> card-height: 75px;

    // Row 0 left stack, in upstream order (the markers of the kind).
    in property <[CardMarker]> markers: [];
    // Sigil dungeon-tier button (upstream red bold tier text next to the
    // markers, shown while the tier display is enabled,
    // `AffixView.xaml:1769-1784`).
    in property <string> tier-label: "";
    // Class badge row (affix/aspect/unique templates).
    in property <bool> show-classes: false;
    in property <bool> class-sorc;
    in property <bool> class-druid;
    in property <bool> class-barb;
    in property <bool> class-rogue;
    in property <bool> class-necro;
    in property <bool> class-spirit;
    in property <bool> class-pala;
    in property <bool> class-warlk;
    // Rune cards carry the bold name inside the marker row; the other named
    // kinds (aspect/sigil/unique) carry it on its own line under the markers.
    in property <bool> name-in-header: false;
    in property <bool> show-name: false;
    in property <string> entry-name: "";
    // Affix cards carry the localized description alone (upstream
    // `AffixInfoWanted` row 1).
    in property <string> entry-description: "";

    // Accessible name of the "+" control (`rsTooltipSetAffix` and friends).
    in property <string> add-label: "";

    callback add-clicked();
    callback cycle-tier-clicked();

    Rectangle {
        background: Metro.card;
        border-radius: 5px;
        preferred-width: card-width;
        min-width: card-width;
        max-width: card-width;
        preferred-height: card-height;
        min-height: card-height;
        max-height: card-height;

        // Double click on the card body adds/edits like the "+" button
        // (upstream MouseBinding LeftDoubleClick).
        TouchArea {
            width: parent.width;
            height: parent.height;
            double-clicked => { add-clicked(); }
        }

        VerticalLayout {
            padding: 6px;
            spacing: 2px;

            // Row 0: markers (and the rune name) left, class badges and "+"
            // right.
            HorizontalLayout {
                spacing: 2px;

                if tier-label != "": Rectangle {
                    background: transparent;
                    preferred-width: 30px;
                    min-width: 30px;
                    max-width: 30px;
                    preferred-height: 20px;
                    min-height: 20px;
                    max-height: 20px;
                    // Accessibility + headless real-input test harness: the
                    // tier button is addressed by its card.
                    accessible-role: button;
                    accessible-label: @tr("Cycle tier for {}", entry-name);

                    Text {
                        text: tier-label;
                        color: Metro.tier-text;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { cycle-tier-clicked(); }
                    }

                    Tooltip { text: @markdown("\{@tr("Dungeon tier")}"); }
                }

                for marker in markers: Image {
                    // An empty label is the "marker absent" case (upstream
                    // binds each marker's visibility to its entry flag): the
                    // image stays out of the row and out of the a11y tree.
                    visible: marker.label != "";
                    width: 20px;
                    height: 20px;
                    source: marker.icon;
                    accessible-label: marker.label;
                    Tooltip { text: @markdown("\{marker.label}"); }
                }

                if name-in-header: Text {
                    text: entry-name;
                    color: Metro.text;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle {
                    background: transparent;
                }

                if show-classes: ClassBadgeRow {
                    class-sorc: class-sorc;
                    class-druid: class-druid;
                    class-barb: class-barb;
                    class-rogue: class-rogue;
                    class-necro: class-necro;
                    class-spirit: class-spirit;
                    class-pala: class-pala;
                    class-warlk: class-warlk;
                }

                CardAddButton {
                    label: add-label;
                    clicked => { add-clicked(); }
                }
            }

            // Row 1: bold name (aspect/sigil/unique).
            if show-name: Text {
                text: entry-name;
                color: Metro.text;
                font-size: 13px;
                font-weight: 700;
                overflow: elide;
            }

            // Row 1/2: the localized description (upstream
            // `AffixIdToDescriptionConverter` / `Description` bindings).
            Text {
                text: entry-description;
                color: Metro.text;
                font-size: 13px;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }
}

// Category config (cog) cell — the first cell of every grid, opening the
// per-category config dialog (upstream `AffixInfoConfig` / `AspectInfoConfig`
// / ... templates with the 50px cog, `AffixView.xaml:1502-1520`).
// `label` carries the accessible button name per instance
// (upstream *ConfigCommand anchor); the cell size follows the kind's card.
export component ConfigCell {
    in property <string> label;
    in property <length> cell-width: 250px;
    in property <length> cell-height: 75px;
    callback clicked();

    Rectangle {
        background: Metro.card;
        border-radius: 5px;
        preferred-width: cell-width;
        min-width: cell-width;
        max-width: cell-width;
        preferred-height: cell-height;
        min-height: cell-height;
        max-height: cell-height;
        // Accessibility + headless real-input test harness.
        accessible-role: button;
        accessible-label: root.label;

        CogIcon {
            width: 50px;
            height: 50px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon-color: Metro.text;
            hole-color: Metro.card;
        }

        TouchArea {
            clicked => { clicked(); }
        }
    }
}
