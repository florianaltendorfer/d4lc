import { ScrollView } from "std-widgets.slint";

// Trade screen — Slint rendering of TradeView.xaml.
// Upstream: TradeView.xaml:1-195, TradeViewModel.cs:51-54,78-81
// 4 commands from TradeViewModel.cs exposed as callbacks.
// State from d4lc-gui::TradeImportsPanelState.

// ── Data structs for Rust → Slint binding ────────────────────────────

// One affix row of a wanted card: the display text (the resolved
// affix description, upstream `AffixIdToDescriptionConverter`,
// TradeView.xaml resources) and the IsGreater flag that selects the
// foreground color (upstream `AffixTypeToFgSolidBrushConverter`:
// Orange for greater, White otherwise).
export struct TradeAffixDisplay {
    text: string,
    is-greater: bool,
}

export struct TradeItem {
    item-id: string,
    item-type: string,
    // Two-letter type monogram standing in for the upstream type icon
    // (TradeView.xaml:109 binds `Type.Image`; the port renders a
    // text badge in place of the image assets).
    badge: string,
    value: string,
    affixes: [TradeAffixDisplay],
}

// ── Reusable sub-components (internal to this file) ───────────────────

// Add Trade Item card — cog config button + large plus button.
// Upstream: TradeView.xaml:26-55 (DataTemplate for TradeItemAdd).
component AddTradeCard {
    callback config-clicked();
    callback add-clicked();

    Rectangle {
        background: #1F1F1F;
        border-width: 1px;
        border-color: #3F3F46;
        border-radius: 4px;
        preferred-width: 150px;
        min-width: 150px;
        max-width: 150px;
        preferred-height: 200px;
        min-height: 200px;
        max-height: 200px;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Top row: Cog config button (right-aligned)
            // Upstream: TradeView.xaml:40-45
            HorizontalLayout {
                padding: 4px;
                alignment: end;

                Rectangle {
                    background: transparent;
                    preferred-width: 28px;
                    preferred-height: 28px;
                    // Accessibility + headless real-input test harness
                    // (upstream TradeConfigCommand anchor).
                    accessible-role: button;
                    accessible-label: @tr("Trade config");
                    Text {
                        text: "⚙"; // ⚙ cog
                        color: #FFFFFF;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { config-clicked(); }
                    }
                }
            }

            // Bottom area: Large Plus button (centered)
            // Upstream: TradeView.xaml:47-52
            // (upstream AddTradeItemCommand anchor).
            Rectangle {
                background: transparent;
                accessible-role: button;
                accessible-label: @tr("Add trade item");
                Text {
                    text: "+";
                    color: #FFFFFF;
                    font-size: 50px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
                TouchArea {
                    clicked => { add-clicked(); }
                }
            }
        }
    }
}

// Current Item card — read-only parsed item display.
// Upstream: TradeView.xaml:58-96 (DataTemplate for TradeItemCurrent).
component CurrentItemCard {
    in property <string> item-type;
    in property <int> item-power;
    in property <[string]> affixes;

    Rectangle {
        background: #1F1F1F;
        border-width: 1px;
        border-color: #3F3F46;
        border-radius: 4px;
        preferred-width: 250px;
        min-width: 250px;
        max-width: 250px;
        preferred-height: 200px;
        min-height: 200px;
        max-height: 200px;

        VerticalLayout {
            spacing: 0px;

            // Header row: "Current Item" label
            // Upstream: TradeView.xaml:70-73
            Rectangle {
                background: #262626;
                border-width: 1px;
                border-color: #3F3F46;
                preferred-height: 30px;
                min-height: 30px;
                Text {
                    text: @tr("Current Item");
                    color: #FFFFFF;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: start;
                }
            }

            // Content area (scrollable read-only fields)
            // Upstream: TradeView.xaml:76-91
            ScrollView {
                preferred-height: 170px;
                min-height: 170px;

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    // Item Type (read-only)
                    Text {
                        text: @tr("Item Type: {}", item-type);
                        color: #FFFFFF;
                        font-size: 13px;
                        overflow: elide;
                    }

                    // Item Power (read-only)
                    Text {
                        text: @tr("Item Power: {}", item-power);
                        color: #FFFFFF;
                        font-size: 13px;
                        overflow: elide;
                    }

                    // Affixes header
                    Text {
                        text: @tr("Affixes:");
                        color: #9E9E9E;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    // Affix list
                    for affix in affixes: Text {
                        text: "  • " + affix;
                        color: #CCCCCC;
                        font-size: 12px;
                        overflow: elide;
                    }

                    // Empty affix state
                    if affixes.length == 0: Text {
                        text: @tr("  No affixes available.");
                        color: #868686;
                        font-size: 12px;
                    }
                }
            }
        }
    }
}

// Wanted Trade Item card — item type, value, affixes, edit/remove buttons.
// Upstream: TradeView.xaml:98-184 (DataTemplate for TradeItemWanted).
component WantedTradeCard {
    in property <string> item-id;
    in property <string> item-type;
    in property <string> badge;
    in property <string> value;
    in property <[TradeAffixDisplay]> affixes;

    callback remove-clicked();
    callback edit-clicked();

    Rectangle {
        background: #1F1F1F;
        border-width: 1px;
        border-color: #3F3F46;
        border-radius: 4px;
        preferred-width: 250px;
        min-width: 250px;
        max-width: 250px;

        VerticalLayout {
            spacing: 0px;

            // ── Header: Item type name + Remove/Edit buttons
            // Upstream: TradeView.xaml:101-128
            Rectangle {
                background: #262626;
                border-width: 1px;
                border-color: #3F3F46;
                preferred-height: 40px;
                min-height: 40px;

                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;

                    // Item type badge — the port's stand-in for the
                    // upstream type image (TradeView.xaml:109 binds
                    // `Type.Image`).
                    Rectangle {
                        background: #333333;
                        border-radius: 3px;
                        preferred-width: 32px;
                        preferred-height: 22px;

                        Text {
                            text: badge;
                            color: #FFD700;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Item type name
                    // Upstream: TradeView.xaml:111 (Label Content="{Binding Type.Name}")
                    Text {
                        text: item-type;
                        color: #FFFFFF;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // Spacer
                    Rectangle {
                        background: transparent;
                    }

                    // Remove button (X / CloseThick)
                    // Upstream: TradeView.xaml:113-119
                    // (upstream RemoveTradeItemCommand anchor).
                    Rectangle {
                        background: transparent;
                        preferred-width: 28px;
                        preferred-height: 28px;
                        accessible-role: button;
                        accessible-label: @tr("Remove {}", item-type);
                        Text {
                            text: "✖"; // ✖
                            color: #B01E24;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { remove-clicked(); }
                        }
                    }

                    // Edit button (cog)
                    // Upstream: TradeView.xaml:120-127
                    // (upstream EditTradeItemCommand anchor).
                    Rectangle {
                        background: transparent;
                        preferred-width: 28px;
                        preferred-height: 28px;
                        accessible-role: button;
                        accessible-label: @tr("Edit {}", item-type);
                        Text {
                            text: "⚙"; // ⚙
                            color: #FFFFFF;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { edit-clicked(); }
                        }
                    }
                }
            }

            // ── Value display with gold diamond icon
            // Upstream: TradeView.xaml:131-140
            Rectangle {
                background: #262626;
                border-width: 1px;
                border-color: #3F3F46;
                preferred-height: 30px;
                min-height: 30px;

                HorizontalLayout {
                    padding: 4px;
                    spacing: 6px;

                    // Gold diamond icon (small)
                    Text {
                        text: "◆"; // ◆
                        color: #FFD700;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    // Value text
                    Text {
                        text: value;
                        color: #FFD700;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // ── Affix list (scrollable)
            // Upstream: TradeView.xaml:142-182
            Rectangle {
                background: #262626;
                border-width: 1px;
                border-color: #3F3F46;

                ScrollView {
                    preferred-height: 125px;
                    min-height: 125px;

                    VerticalLayout {
                        padding: 4px;
                        spacing: 3px;

                        // Affix entries — the resolved description text
                        // with the upstream color split
                        // (AffixTypeToFgSolidBrushConverter: Orange for
                        // IsGreater, White otherwise).
                        for affix in affixes: Rectangle {
                            background: #333333;
                            border-radius: 3px;
                            preferred-height: 24px;
                            min-height: 24px;

                            Text {
                                text: affix.text;
                                color: affix.is-greater ? #FFA500 : #FFFFFF;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        // Empty affix state
                        if affixes.length == 0: Text {
                            text: @tr("No affixes specified.");
                            color: #868686;
                            font-size: 12px;
                        }
                    }
                }
            }
        }
    }
}
export component TradeScreen {
    // ── State properties (set from Rust) ───────────────────────────────
    in property <[TradeItem]> trade-items;
    in property <string> current-item-type;
    in property <int> current-item-power;
    in property <[string]> current-affixes;
    // Whether the CurrentItemCard renders at all — upstream filters the
    // current card out of `TradeItemsFiltered` when
    // `Settings.ShowCurrentItem` is false (TradeViewModel.cs:209-216,
    // default `true` per SettingsD4.cs:83).
    in property <bool> show-current-item: true;

    // ── Callbacks (4 commands from TradeViewModel.cs:78-81) ────────────
    callback add_trade_item();
    callback edit_trade_item(string);
    callback remove_trade_item(string);
    callback open_trade_config();

    // ── Theme ──────────────────────────────────────────────────────────
    property <color> bg-color: #262626;
    property <color> text-color: #FFFFFF;
    property <color> dim-color: #868686;
    property <color> gold-color: #FFD700;

    // ── Layout (upstream readme layout: page title + card surface;
    // mirrors TradeView.xaml:22-193 ScrollViewer > WrapPanel) ───────────
    VerticalLayout {
        spacing: 0px;

        // ── Page title (upstream ContentTemplate header label) ────────
        HorizontalLayout {
            padding-left: 24px;
            padding-top: 10px;
            padding-bottom: 4px;

            Text {
                text: @tr("Trading");
                color: text-color;
                font-size: 40px;
                font-weight: 300;
                vertical-alignment: center;
            }
        }

        ScrollView {
            // Use VerticalLayout as Slint approximation of WrapPanel.
            // Add + Current cards in top row; wanted cards flow below.
            VerticalLayout {
                padding-left: 24px;
                padding-right: 16px;
                padding-bottom: 8px;
                spacing: 8px;

                // ═══════════════════════════════════════════════════
                // Top row: Add Card + Current Item Card (side by side)
                // ═══════════════════════════════════════════════════
                HorizontalLayout {
                    spacing: 8px;

                    // ── Add Card (mirrors TradeView.xaml:26-55) ──────
                    AddTradeCard {
                        config-clicked => { open_trade_config(); }
                        add-clicked => { add_trade_item(); }
                    }

                    // ── Current Item Card (mirrors TradeView.xaml:58-96)
                    // Hidden when the ShowCurrentItem setting is off
                    // (upstream FilterTradeItems, TradeViewModel.cs:213).
                    if show-current-item: CurrentItemCard {
                        item-type: current-item-type;
                        item-power: current-item-power;
                        affixes: current-affixes;
                    }
                }

                // ═══════════════════════════════════════════════════
                // Wanted Trade Item Cards (mirrors TradeView.xaml:98-184)
                // Each card is rendered for each item in trade-items.
                // Wrapping approximated by stacking in vertical flow.
                // ═══════════════════════════════════════════════════
                for item in trade-items: WantedTradeCard {
                    item-id: item.item-id;
                    item-type: item.item-type;
                    badge: item.badge;
                    value: item.value;
                    affixes: item.affixes;

                    remove-clicked => { remove_trade_item(item.item-id); }
                    edit-clicked => { edit_trade_item(item.item-id); }
                }

                // Empty state when no wanted trade items
                if trade-items.length == 0: Text {
                    text: @tr("No trade items. Click the plus button to get started.");
                    color: dim-color;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
