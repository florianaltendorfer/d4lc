// Set preset name dialog.
//
// Upstream: `AddAffixPresetNameCommand` flow
// (`AffixViewModel.cs:919-931`). The inline `new-preset-name`
// TextInput + "+" button on the AffixScreen remains the
// default way to add a new preset. This dialog is the alternate
// dialog-driven path for users that prefer a modal flow. It is
// reachable from the new "New Preset..." button added to the
// build-import toolbar (matching the build-import toolbar
// pattern).
//
// The Slint form value contract mirrors the no-Slint-global
// host plumbing used by the SetAffix / SetAffixColor /
// AddTradeItem / BuildImport dialogs:
//
// - The new preset name (text input) is projected on the
//   root `AppWindow` as `set-preset-name-input` (see
//   `main_window.slint`). The dialog binds its text input to
//   that root in-out property, so the value flows directly
//   between Slint and Rust.
// - Confirm / cancel flow through the shared dialog host
//   `dialog-confirm` / `dialog-cancel` callbacks, which the
//   shared `actions::dialogs` router dispatches to
//   `actions::affix_dialogs::handle_confirm` /
//   `handle_cancel`.
// - Validation errors (empty name, collision) are surfaced
//   through the shared `dialog-error` / `dialog-error-visible`
//   props; the router keeps the dialog open on failure.
//
// Scope:
// - The dialog persists the new preset in
//   `state.affix_preset_editor` (in-memory) and refreshes
//   the `preset-names` model + `selected-preset` projection.
import { DarkLineEdit } from "dark_line_edit.slint";

export component SetPresetNameDialog {
    in property <string> dialog-title: @tr("Confirm name");
    in property <string> dialog-error: "";
    in property <bool> dialog-error-visible: false;

    // Form value — bound to the root in-out property in
    // `main_window.slint` so Rust can read it via
    // `app.get_set_preset_name_input()`.
    in-out property <string> set-preset-name-input: "";

    callback confirm();
    callback cancel();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // ── Title ───────────────────────────────────────────────────
        Text {
            text: dialog-title;
            color: #EEEEEE;
            font-size: 16px;
            font-weight: 700;
        }

        // ── Error banner ───────────────────────────────────────────
        if dialog-error-visible: Text {
            text: dialog-error;
            color: #FF6666;
            font-size: 12px;
            wrap: word-wrap;
        }

        // ── New preset name input ──────────────────────────────────
        Text {
            text: @tr("Preset name");
            color: #CCCCCC;
            font-size: 12px;
        }
        // Shared dark field: the std-widgets LineEdit renders light on
        // the dark theme.
        DarkLineEdit {
            text <=> set-preset-name-input;
            placeholder-text: @tr("e.g. Speed, Boss, AoE");
            // Enter confirms within the field's own scope, matching
            // the provider/import dialog family.
            accepted => {
                confirm();
            }
        }

        // Spacer pushes buttons to the bottom.
        Rectangle { background: transparent; }

        // ── Confirm / Cancel ───────────────────────────────────────
        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            Rectangle {
                background: #555555;
                border-radius: 4px;
                preferred-width: 80px;
                preferred-height: 28px;
                // Accessibility + headless real-input test harness.
                accessible-role: button;
                accessible-label: @tr("Cancel");
                Text {
                    text: @tr("Cancel");
                    color: #EEEEEE;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { cancel(); }
                }
            }

            Rectangle {
                background: #CC3333;
                border-radius: 4px;
                preferred-width: 80px;
                preferred-height: 28px;
                // Accessibility + headless real-input test harness.
                accessible-role: button;
                accessible-label: @tr("Apply");
                Text {
                    text: @tr("Done");
                    color: #EEEEEE;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { confirm(); }
                }
            }
        }
    }
}
