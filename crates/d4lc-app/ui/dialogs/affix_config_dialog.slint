// Affix config dialog — upstream `AffixConfigView.xaml` +
// `AffixConfigViewModel.cs`.
//
// Control set (upstream XAML lines in brackets):
//
// - "Tempered affix detection" toggle [AffixConfigView.xaml:30-38]
//   → `IsTemperedAffixDetectionEnabled` (AffixConfigViewModel.cs:79-89).
//   Consumer: the OCR segment plan (`d4lc-runtime` carries the persisted
//   flag into `OcrSegmentPlanInput.tempered_detection_enabled`; d4lc-ocr
//   gates tempered-affix detection on it).
// - "Tuning prism hints" toggle [XAML:40-48] → `IsTuningPrismHintsEnabled`
//   (AffixConfigViewModel.cs:91-101). Consumer: the overlay rule settings
//   (`RuleOverlaySettings::is_tuning_prism_hints_enabled` draws the
//   tuning-prism hint circles).
// - "Minimal affix value filter" toggle [XAML:50-55] →
//   `IsMinimalAffixValueFilterEnabled` (AffixConfigViewModel.cs:55-65).
//   Consumer: the rule value filter (the per-affix threshold comparison in
//   `app_state`'s rule preparation).
// - "Reset minimal affix values" button [XAML:56-59] →
//   `ResetMinimalAffixValuesCommand` (AffixConfigViewModel.cs:114-123). The
//   upstream message-box confirmation is the shared window-modal confirm
//   prompt: the click reports through
//   `reset-minimal-affix-values`, the host asks with the upstream
//   "Are you sure you want to reset the minimal affix values?" copy and runs
//   the reset on Yes only.
// - "Multi-build mode" toggle [XAML:64-69] → `IsMultiBuildModeEnabled`
//   (AffixConfigViewModel.cs:67-77). Consumer: the multi-build rule
//   projection and the build-import rotation mirror.
// - "Multi-build config" / "Manage colors" buttons [XAML:70-73, 78-85] →
//   `SetMultiBuildCommand` / `SetColorsCommand`: they open the existing
//   `multi_build_config` and `colors_config` dialogs through the host's
//   `open-multi-build-config` / `dialog-open-colors` callbacks.
// - Close [XAML:87-93, upstream `AffixConfigDoneCommand`]: the upstream
//   toggles save from their setters, so Done only closes; this dialog keeps
//   the port's existing "Close" label (the harness's config-dialog cycle
//   asserts it).
//
// ## Host contract
//
// The rule-setting properties are two-way bound to host root properties and
// the host seeds them from `state.shell.settings` when it opens the dialog,
// exactly like the overlay/paragon dialogs:
//
//     settings-rule-minimal-affix-value-filter-enabled
//     settings-rule-multi-build-enabled
//     settings-rule-tempered-affix-detection-enabled
//     settings-rule-tuning-prism-hints-enabled
//
// Every toggle click reports the new value through `rule-toggle-changed`,
// which the host forwards to the root callback wired to
// `actions::affix_dialogs::handle_rule_setting_toggled`; the reset button
// reports through `reset-minimal-affix-values`, which the host forwards to
// `handle_reset_minimal_affix_values` — that handler opens the shared
// confirm prompt, and its Yes path (`handle_confirm_reset_minimal_affix_values`)
// rewrites the threshold file, re-runs the value-filter projection, and
// reopens this dialog so the user stays where they were. The handlers persist
// the settings file and re-project the live consumers, so the dialog never
// holds unsaved state.
//
// Harness: the four switches are new UI toggles, so
// `TOGGLE_SWEEP_TABLE` in `testing_harness.rs` needs one row per switch
// (labels "Tempered affix detection", "Tuning prism hints", "Minimal affix
// value filter", "Multi-build mode", source
// `ui/dialogs/affix_config_dialog.slint`) — the toggle-table source scan
// asserts the table matches the .slint sources exactly.

export component AffixConfigDialog {
    in property <string> dialog-title: @tr("Affix Config");
    in property <string> dialog-error: "";
    in property <bool> dialog-error-visible: false;

    // Rule-setting values, seeded by the host from the persisted settings.
    in-out property <bool> settings-rule-minimal-affix-value-filter-enabled: false;
    in-out property <bool> settings-rule-multi-build-enabled: false;
    in-out property <bool> settings-rule-tempered-affix-detection-enabled: false;
    in-out property <bool> settings-rule-tuning-prism-hints-enabled: false;

    callback confirm();
    callback cancel();
    callback rule-toggle-changed(string, bool);
    callback reset-minimal-affix-values();
    callback open-multi-build-config();
    callback open-colors-config();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // ── Title ───────────────────────────────────────────────────
        Text {
            text: dialog-title;
            color: #EEEEEE;
            font-size: 16px;
            font-weight: 700;
        }

        // ── Error banner ───────────────────────────────────────────
        if dialog-error-visible: Text {
            text: dialog-error;
            color: #FF6666;
            font-size: 12px;
            wrap: word-wrap;
        }

        // ── Tempered affix detection ───────────────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Text {
                text: @tr("Tempered Affix Detection");
                color: #EEEEEE;
                font-size: 13px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            Rectangle {
                background: settings-rule-tempered-affix-detection-enabled ? #CC3333 : #555555;
                border-radius: 10px;
                preferred-width: 36px;
                preferred-height: 20px;
                min-width: 36px;
                min-height: 20px;
                // Accessibility + headless real-input test harness.
                accessible-role: switch;
                accessible-label: @tr("Tempered affix detection");

                Rectangle {
                    background: #EEEEEE;
                    border-radius: 9px;
                    width: 16px;
                    height: 16px;
                    x: settings-rule-tempered-affix-detection-enabled ? 18px : 2px;
                    y: 2px;
                }

                TouchArea {
                    clicked => {
                        settings-rule-tempered-affix-detection-enabled = !settings-rule-tempered-affix-detection-enabled;
                        rule-toggle-changed("tempered_affix_detection_enabled", settings-rule-tempered-affix-detection-enabled);
                    }
                }
            }
        }

        // ── Tuning prism hints ─────────────────────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Text {
                text: @tr("Show Tuning Prism Hints");
                color: #EEEEEE;
                font-size: 13px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            Rectangle {
                background: settings-rule-tuning-prism-hints-enabled ? #CC3333 : #555555;
                border-radius: 10px;
                preferred-width: 36px;
                preferred-height: 20px;
                min-width: 36px;
                min-height: 20px;
                // Accessibility + headless real-input test harness.
                accessible-role: switch;
                accessible-label: @tr("Tuning prism hints");

                Rectangle {
                    background: #EEEEEE;
                    border-radius: 9px;
                    width: 16px;
                    height: 16px;
                    x: settings-rule-tuning-prism-hints-enabled ? 18px : 2px;
                    y: 2px;
                }

                TouchArea {
                    clicked => {
                        settings-rule-tuning-prism-hints-enabled = !settings-rule-tuning-prism-hints-enabled;
                        rule-toggle-changed("tuning_prism_hints_enabled", settings-rule-tuning-prism-hints-enabled);
                    }
                }
            }
        }

        // ── Minimal affix value filter + reset ─────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Text {
                text: @tr("Minimal Affix Value Filter");
                color: #EEEEEE;
                font-size: 13px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            Rectangle {
                background: settings-rule-minimal-affix-value-filter-enabled ? #CC3333 : #555555;
                border-radius: 10px;
                preferred-width: 36px;
                preferred-height: 20px;
                min-width: 36px;
                min-height: 20px;
                // Accessibility + headless real-input test harness.
                accessible-role: switch;
                accessible-label: @tr("Minimal affix value filter");

                Rectangle {
                    background: #EEEEEE;
                    border-radius: 9px;
                    width: 16px;
                    height: 16px;
                    x: settings-rule-minimal-affix-value-filter-enabled ? 18px : 2px;
                    y: 2px;
                }

                TouchArea {
                    clicked => {
                        settings-rule-minimal-affix-value-filter-enabled = !settings-rule-minimal-affix-value-filter-enabled;
                        rule-toggle-changed("minimal_affix_value_filter_enabled", settings-rule-minimal-affix-value-filter-enabled);
                    }
                }
            }

            Rectangle {
                background: #555555;
                border-radius: 4px;
                preferred-width: 110px;
                preferred-height: 24px;
                // Accessibility + headless real-input test harness.
                accessible-role: button;
                accessible-label: @tr("Reset minimal affix values");
                Text {
                    text: @tr("Reset values");
                    color: #EEEEEE;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { reset-minimal-affix-values(); }
                }
            }
        }

        // ── Multi-build mode ───────────────────────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Text {
                text: @tr("Multi Build Mode");
                color: #EEEEEE;
                font-size: 13px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            Rectangle {
                background: settings-rule-multi-build-enabled ? #CC3333 : #555555;
                border-radius: 10px;
                preferred-width: 36px;
                preferred-height: 20px;
                min-width: 36px;
                min-height: 20px;
                // Accessibility + headless real-input test harness.
                accessible-role: switch;
                accessible-label: @tr("Multi-build mode");

                Rectangle {
                    background: #EEEEEE;
                    border-radius: 9px;
                    width: 16px;
                    height: 16px;
                    x: settings-rule-multi-build-enabled ? 18px : 2px;
                    y: 2px;
                }

                TouchArea {
                    clicked => {
                        settings-rule-multi-build-enabled = !settings-rule-multi-build-enabled;
                        rule-toggle-changed("multi_build_mode_enabled", settings-rule-multi-build-enabled);
                    }
                }
            }

            Rectangle {
                background: #555555;
                border-radius: 4px;
                preferred-width: 130px;
                preferred-height: 24px;
                // Accessibility + headless real-input test harness.
                accessible-role: button;
                accessible-label: @tr("Multi-build config");
                Text {
                    text: @tr("Multi-build config");
                    color: #EEEEEE;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { open-multi-build-config(); }
                }
            }

            Rectangle {
                background: #555555;
                border-radius: 4px;
                preferred-width: 110px;
                preferred-height: 24px;
                // Accessibility + headless real-input test harness.
                accessible-role: button;
                accessible-label: @tr("Manage colors");
                Text {
                    text: @tr("Manage Colors");
                    color: #EEEEEE;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { open-colors-config(); }
                }
            }
        }

        // Spacer pushes buttons to the bottom.
        Rectangle { background: transparent; }

        // ── Close / Cancel ─────────────────────────────────────────
        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            Rectangle {
                background: #555555;
                border-radius: 4px;
                preferred-width: 80px;
                preferred-height: 28px;
                // Accessibility + headless real-input test harness.
                accessible-role: button;
                accessible-label: @tr("d4lc" => "Cancel");
                Text {
                    text: @tr("d4lc" => "Cancel");
                    color: #EEEEEE;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { cancel(); }
                }
            }

            Rectangle {
                background: #CC3333;
                border-radius: 4px;
                preferred-width: 80px;
                preferred-height: 28px;
                // Accessibility + headless real-input test harness.
                accessible-role: button;
                accessible-label: @tr("Close");
                Text {
                    text: @tr("Done");
                    color: #EEEEEE;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { confirm(); }
                }
            }
        }
    }
}
