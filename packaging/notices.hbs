<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>d4lc — Rust dependency license notices</title>
<style>
  body { font-family: sans-serif; margin: 2rem; color: #111; }
  h1 { font-size: 1.4rem; }
  h2 { font-size: 1.1rem; margin-top: 2rem; }
  ul.crates { columns: 2; }
  pre { background: #f4f4f4; padding: 0.75rem; overflow-x: auto; white-space: pre-wrap; }
</style>
</head>
<body>
<h1>d4lc — Rust dependency license notices</h1>
<p>
  Third-party Rust crates linked into the d4lc release binaries, grouped by
  the license that satisfies them. Generated with
  <a href="https://github.com/EmbarkStudios/cargo-about">cargo-about</a>
  from the locked workspace manifest; regenerate with the release workflow's
  "Generate Rust dependency notices" step.
</p>

{{#each overview}}
<h2>{{name}} ({{count}})</h2>
<ul class="crates">
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
{{/each}}

{{#each licenses}}
{{#if first_of_kind}}
<h2 id="{{id}}">{{name}}</h2>
<pre>{{text}}</pre>
{{/if}}
{{/each}}
</body>
</html>
